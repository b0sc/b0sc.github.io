{
  "facultyInfo": {
    "salientFeatures": [
      "Tribhuvan University has launched Bachelor of Computer Application (BCA) program from the academic year 2074/75.",
      "Semester-system under the faculties of Humanities and Social Sciences.",
      "Objective: produce high quality computer application users and developers.",
      "Study period: eight semesters (four academic years).",
      "Academic year begins in September and February each year.",
      "The medium of instruction and examination is English."
    ],
    "eligibility": [
      "Passed in 2079 B.S.: Minimum D grade in each subject of grade 11 and 12 with a CGPA 1.8 or more, Minimum score of second division marks in 10+2, PCL, or equivalent in any discipline.",
      "Students who have passed grade 11 and are waiting for grade 12 results can also apply (must submit all required documents at admission).",
      "Passed before 2079 B.S.: Minimum D grade in each subject of grade 11 and 12 with a CGPA 2.0 or more, Minimum score of second division marks in 10+2, PCL, or equivalent in any discipline."
    ],
    "jobProspects": [
      "System analysts",
      "System managers",
      "Project managers",
      "Database administrators",
      "System designers",
      "Programmers in IT Companies and other industries",
      "Eligible for further studies such as MCA, MIT, MBA, etc."
    ],
    "curricularStructure": "130 credit hours over eight semesters, with project work in semesters 4 to 7 and a mandatory internship in semester 8."
  },
