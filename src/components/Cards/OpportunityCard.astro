---
import { formatDate } from "../../utils/utils"

export interface Opportunity {
  id: string
  name: string
  organizer: string
  category: string
  scope: string
  mode: string
  summary: string
  benefits: string[]
  eligibility: string[]
  timeline: string
  // ISO date of the next deadline or event day, when one is announced
  deadline?: string
  stipend?: string
  url: string
  links?: { label: string; url: string }[]
  lastVerified: string
}

interface Props {
  opportunity: Opportunity
}

const { opportunity: op } = Astro.props
---

<article
  data-category={op.category}
  data-scope={op.scope}
  class="flex flex-col p-6 bg-white rounded-3xl border border-zinc-900 shadow-card"
>
  <div class="flex flex-wrap items-center gap-2 text-xs font-medium">
    <span class="bg-lime-500 px-2.5 py-0.5 rounded">{op.category}</span>
    <span class="bg-zinc-100 px-2.5 py-0.5 rounded">{op.scope}</span>
    <span class="bg-zinc-100 px-2.5 py-0.5 rounded">{op.mode}</span>
    {
      op.deadline && (
        <span
          data-deadline={op.deadline}
          class="bg-zinc-900 text-lime-500 px-2.5 py-0.5 rounded"
        >
          Next: {formatDate(new Date(op.deadline))}
        </span>
      )
    }
  </div>

  <h3 class="mt-4 text-2xl font-bold tracking-tight">{op.name}</h3>
  <p class="text-sm text-gray-500">{op.organizer}</p>
  <p class="mt-3 text-gray-700">{op.summary}</p>

  <dl class="mt-4 grid gap-3 text-sm">
    {
      op.stipend && (
        <div>
          <dt class="font-bold">Stipend</dt>
          <dd class="text-gray-700">{op.stipend}</dd>
        </div>
      )
    }
    <div>
      <dt class="font-bold">When</dt>
      <dd class="text-gray-700">{op.timeline}</dd>
    </div>
  </dl>

  <details class="group mt-4 border-t border-gray-200 pt-3">
    <summary
      class="cursor-pointer select-none text-sm font-medium list-none flex items-center gap-2"
    >
      <span class="transition-transform group-open:rotate-90">▸</span>
      Benefits and eligibility
    </summary>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 text-sm">
      <div>
        <p class="font-bold mb-1">What you get</p>
        <ul class="list-disc pl-5 space-y-1 text-gray-700">
          {op.benefits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="font-bold mb-1">Who can apply</p>
        <ul class="list-disc pl-5 space-y-1 text-gray-700">
          {op.eligibility.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </details>

  <div class="mt-auto pt-5 flex flex-wrap items-center gap-3">
    <a
      href={op.url}
      target="_blank"
      rel="noopener noreferrer"
      class="px-5 py-2 bg-zinc-900 hover:bg-white text-white hover:text-black border border-zinc-900 rounded-2xl"
    >
      Official page
    </a>
    {
      op.links?.map((link) => (
        <a
          href={link.url}
          {...(link.url.startsWith("http")
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {})}
          class="px-5 py-2 bg-white hover:bg-black text-black hover:text-white border border-zinc-900 rounded-2xl"
        >
          {link.label}
        </a>
      ))
    }
    <span class="ml-auto text-xs text-gray-500">
      Checked {formatDate(new Date(op.lastVerified))}
    </span>
  </div>
</article>
