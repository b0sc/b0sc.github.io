---
interface Props {
  // Thread identifier. Defaults to the page path. Pages that moved keep
  // their original identifier so existing comment threads stay attached.
  identifier?: string
}

const { identifier = Astro.url.pathname } = Astro.props
---

<div id="disqus_thread" data-identifier={identifier}></div>
<script is:inline>
  function load(thread) {
    // The page may have changed since the observer was set up
    if (!thread.isConnected) return
    const pageIdentifier = thread.dataset.identifier || window.location.pathname
    const pageUrl = "https://bosc.org.np" + pageIdentifier
    thread.innerHTML = ""

    // If DISQUS already loaded, reset it
    if (window.DISQUS) {
      window.DISQUS.reset({
        reload: true,
        config: function () {
          this.page.url = pageUrl
          this.page.identifier = pageIdentifier
        },
      })
    } else {
      // Refreshed on every call: if embed.js is still downloading when the
      // visitor moves to another page, it must pick up that page's thread.
      window.disqus_config = function () {
        this.page.url = pageUrl
        this.page.identifier = pageIdentifier
      }
      if (window.__disqusRequested) return
      window.__disqusRequested = true
      const s = document.createElement("script")
      s.src = "https://bosc-1.disqus.com/embed.js"
      s.setAttribute("data-timestamp", String(+new Date()))
      ;(document.head || document.body).appendChild(s)
    }
  }

  // Load comments only when the thread is about to scroll into view. Loading
  // on page load wasted bandwidth and made embed.js throw when the visitor
  // navigated away before it finished, since the thread was gone by then.
  function disqus() {
    window.__disqusObserver?.disconnect()
    const thread = document.getElementById("disqus_thread")
    if (!thread) return
    window.__disqusObserver = new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        load(thread)
      },
      { rootMargin: "400px" }
    )
    window.__disqusObserver.observe(thread)
  }

  // astro:page-load also fires on the first load, so this covers both cases.
  // Register once: inline scripts re-run after every client-side navigation.
  if (!window.__disqusListener) {
    window.__disqusListener = true
    document.addEventListener("astro:page-load", disqus)
  }
</script>
<noscript
  >Please enable JavaScript to view the <a
    href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a
  ></noscript
>
