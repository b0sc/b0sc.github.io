---
import eventsData from "../data/events.json"

// Group events by year, newest year and newest event first
const years = [...new Set(eventsData.map((event) => event.year))].sort(
  (a, b) => b - a
)
const eventsByYear = years.map((year) => ({
  year,
  events: eventsData
    .filter((event) => event.year === year)
    .sort((a, b) => b.id - a.id),
}))
const firstYear = years[years.length - 1]
---

<div class="mt-8">
  <p class="mb-12 font-light text-gray-500 sm:text-xl text-center">
    From our first session in {firstYear} to today: {eventsData.length} events and
    workshops by the BOSC community.
  </p>

  <ol class="relative border-s-2 border-zinc-900 ms-3 md:ms-6">
    {
      eventsByYear.map(({ year, events }) => (
        <li class="mb-12 ms-6 md:ms-10">
          <span class="absolute -start-[17px] flex items-center justify-center w-8 h-8 rounded-full bg-lime-500 border-2 border-zinc-900" />
          <h3 class="mb-6 text-3xl font-extrabold tracking-tight text-gray-900">
            <span class="px-1.5 bg-lime-500 rounded-md">{year}</span>
            <span class="ms-2 text-base font-normal text-gray-500">
              {events.length} {events.length === 1 ? "event" : "events"}
            </span>
          </h3>
          <ol class="space-y-4">
            {events.map((event) => (
              <li>
                <a
                  href={`/explore/events/${event.id}`}
                  class="group flex flex-col sm:flex-row gap-4 p-4 bg-white rounded-3xl border border-gray-200 shadow-card hover:border-zinc-900 transition-colors"
                >
                  <img
                    src={event.cover_photo || "/services/Illustration.svg"}
                    alt=""
                    loading="lazy"
                    class="w-full sm:w-32 h-32 sm:h-20 object-cover rounded-xl shrink-0"
                  />
                  <div class="min-w-0">
                    <time class="text-sm font-medium text-gray-500">
                      {event.date}
                    </time>
                    <h4 class="text-lg font-bold text-gray-900 group-hover:text-lime-700">
                      {event.name_1} {event.name_2}
                    </h4>
                    <p class="text-sm text-gray-500">{event.venue}</p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
</div>
