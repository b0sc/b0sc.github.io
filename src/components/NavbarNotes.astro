---
import { faculties } from "../utils/notes"

// /notes/<faculty>/<semester>
const [, activeFaculty, activeSemester] = Astro.url.pathname
  .split("/")
  .filter(Boolean)

const googleFormUrl = "https://forms.gle/duyocPr81Sy6nqfa8"
---

<nav
  aria-label="Notes navigation"
  class="md:w-56 shrink-0 md:min-h-screen md:border-r md:border-gray-200"
>
  <div class="md:sticky md:top-20 py-4 md:pr-4 space-y-2">
    <a
      href="/notes"
      class={`block px-4 py-2 rounded-md font-medium ${
        !activeFaculty ? "bg-black text-white" : "hover:bg-zinc-100"
      }`}
    >
      All programs
    </a>
    {
      faculties.map((faculty) => (
        <details class="group" open={activeFaculty === faculty.key}>
          <summary
            class={`flex items-center justify-between cursor-pointer px-4 py-2 rounded-md select-none ${
              activeFaculty === faculty.key && !activeSemester
                ? "bg-black text-white"
                : "hover:bg-zinc-100"
            }`}
          >
            <span>{faculty.name}</span>
            <span class="text-xs transition-transform group-open:rotate-90">
              ▸
            </span>
          </summary>
          <ul class="pl-3 py-2 space-y-1">
            <li>
              <a
                href={`/notes/${faculty.key}`}
                class="block px-3 py-1 rounded-md text-sm hover:bg-zinc-100"
              >
                Overview
              </a>
            </li>
            {Array.from({ length: 8 }, (_, i) => String(i + 1)).map((sem) => (
              <li>
                <a
                  href={`/notes/${faculty.key}/${sem}`}
                  aria-current={
                    activeFaculty === faculty.key && activeSemester === sem
                      ? "page"
                      : undefined
                  }
                  class={`block px-3 py-1 rounded-md text-sm ${
                    activeFaculty === faculty.key && activeSemester === sem
                      ? "bg-lime-500 font-medium"
                      : "hover:bg-zinc-100"
                  }`}
                >
                  Semester {sem}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
    <a
      href={googleFormUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex justify-center px-4 py-3 bg-zinc-900 hover:bg-white text-white hover:text-black border border-zinc-900 rounded-2xl"
    >
      Upload resources
    </a>
  </div>
</nav>
