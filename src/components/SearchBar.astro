---
import Search from "astro-pagefind/components/Search"

interface Props {
  // Must be unique per page: the navbar renders a mobile and a desktop bar
  id: string
}

const { id } = Astro.props
---

<!-- for this to work in dev mode build your site once -->
<Search
  id={id}
  className="pagefind-ui search-bar"
  uiOptions={{ showImages: false }}
/>

<style is:inline>
  :root {
    --pagefind-ui-scale: 0.7; /* overall scale of the search bar */
  }
  .search-bar {
    max-width: 300px;
    flex: 1 1 auto; /* Allow it to grow and shrink */
    min-width: 0; /* Important for flex shrinking */
  }
  .search-bar .pagefind-ui {
    width: 100%;
  }
  .search-bar .pagefind-ui__search-input {
    width: 100%;
    min-width: 30px;
  }
  .search-bar .pagefind-ui__drawer {
    position: absolute;
    padding: 0.5rem;
    top: 100%;
    max-width: 40rem;
    min-width: 15rem;
    width: 100%;
    right: 0;
    background-color: white;
    z-index: 60; /* above other content (nav has 50) */
    border-radius: 0.5rem;
    height: 20rem;
    overflow-y: scroll;
    box-shadow: rgba(17, 12, 46, 0.15) 0px 48px 100px 0px;
  }
</style>
