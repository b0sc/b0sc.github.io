---
import Layout from "../../layouts/Layout.astro"
import Container from "../../components/Container.astro"
import ExploreNav from "../../components/ExploreNav.astro"
import { getEntry, render } from "astro:content"
import { formatDate } from "../../utils/utils"

const entry = (await getEntry("documents", "constitution"))!
const { Content, headings } = await render(entry)
const articles = headings.filter((heading) => heading.depth === 2)
---

<Layout
  title="BOSC - Constitution"
  description={entry.data.summary}
  url="https://bosc.org.np/explore/constitution"
>
  <main class="pt-7 pb-16">
    <Container>
      <div class="flex flex-col md:flex-row">
        <ExploreNav />

        <div class="flex-1 min-w-0 p-4">
          <article class="max-w-3xl mx-auto">
            <header class="pb-8 mb-8 border-b border-zinc-900">
              <span
                class="bg-lime-500 text-black text-xs font-medium px-2.5 py-0.5 rounded"
              >
                Official document
              </span>
              <h1
                class="mt-4 text-3xl lg:text-4xl tracking-tight font-extrabold"
              >
                {entry.data.title}
              </h1>
              <p class="mt-3 text-lg text-gray-600">{entry.data.summary}</p>
              <div
                class="mt-6 flex flex-wrap items-center justify-between gap-4"
              >
                <p class="text-sm text-gray-500">
                  Last updated
                  <time datetime={entry.data.lastUpdated.toISOString()}>
                    {formatDate(entry.data.lastUpdated)}
                  </time>
                </p>
                <button
                  type="button"
                  data-print
                  class="print:hidden px-5 py-2 bg-zinc-900 hover:bg-white text-white hover:text-black border border-zinc-900 rounded-2xl"
                >
                  Print / save as PDF
                </button>
              </div>
            </header>

            <nav
              aria-label="Articles"
              class="mb-10 p-6 bg-zinc-100 rounded-3xl print:hidden"
            >
              <p class="font-bold mb-3">Articles</p>
              <ol class="grid gap-x-6 gap-y-1 sm:grid-cols-2">
                {
                  articles.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="hover:underline decoration-lime-500 decoration-2 underline-offset-4"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>

            <div class="document">
              <Content />
            </div>

            <footer
              class="mt-12 pt-6 border-t border-gray-200 text-sm text-gray-500"
            >
              Amendments follow Article XI. Propose a change by contacting the
              committee at
              <a
                href="mailto:mail@bosc.org.np"
                class="underline decoration-lime-500 decoration-2 underline-offset-4"
                >mail@bosc.org.np</a
              >.
            </footer>
          </article>
        </div>
      </div>
    </Container>
  </main>
</Layout>

<style>
  .document :global(h2) {
    @apply mt-12 mb-4 pt-6 border-t border-gray-200 text-2xl font-bold scroll-mt-24;
  }
  .document :global(h2:first-child) {
    @apply mt-0 pt-0 border-t-0;
  }
  .document :global(h3) {
    @apply mt-6 mb-2 text-lg font-bold;
  }
  .document :global(p) {
    @apply my-3 leading-relaxed text-gray-800;
  }
  .document :global(ul) {
    @apply my-3 pl-6 list-disc space-y-2 text-gray-800;
  }
  .document :global(li::marker) {
    @apply text-zinc-900;
  }
  .document :global(strong) {
    @apply font-bold text-black;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelector("[data-print]")
      ?.addEventListener("click", () => window.print())
  })
</script>
