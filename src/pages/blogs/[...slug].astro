---
// Legacy URL: articles now live at /explore/article/<slug>
import { getCollection } from "astro:content"

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog")
  return blogEntries.map((entry) => ({ params: { slug: entry.id } }))
}

return Astro.redirect(`/explore/article/${Astro.params.slug}`, 301)
---
