---
// Legacy URL: the old tabbed /blogs#<tab> page is now split into /explore/<tab>
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to /explore</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://bosc.org.np/explore/articles" />
    <meta http-equiv="refresh" content="0;url=/explore/articles" />
    <script is:inline>
      const tab = window.location.hash.slice(1)
      const tabs = [
        "articles",
        "events",
        "opportunities",
        "alumni",
        "executives",
        "members",
        "history",
      ]
      window.location.replace(
        "/explore/" + (tabs.includes(tab) ? tab : "articles")
      )
    </script>
  </head>
  <body>
    <a href="/explore/articles">Continue to /explore/articles</a>
  </body>
</html>
