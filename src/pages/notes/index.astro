---
import Container from "../../components/Container.astro"
import NavbarNotes from "../../components/NavbarNotes.astro"
import Topic from "../../components/Topic.astro"
import Layout from "../../layouts/Layout.astro"
import { faculties, getFaculty } from "../../utils/notes"

const programs = faculties.map((faculty) => {
  const { data } = getFaculty(faculty.key)
  const courses = data.semesters.reduce(
    (sum, s) => sum + s.courses.length + (s.electiveCourses?.length ?? 0),
    0
  )
  return { ...faculty, courses }
})
---

<Layout
  title="BOSC - Notes"
  description="Semester-wise courses, official TU syllabi, past papers and free learning resources for CSIT, BIT, BCA and BICTE students."
>
  <main class="pt-7 pb-20">
    <Container>
      <div class="flex flex-col md:flex-row gap-6">
        <NavbarNotes />
        <div class="flex-1 min-w-0">
          <div class="relative flex flex-col items-center md:flex-row">
            <Topic
              title="Notes"
              description="Every course in your program, with the official TU syllabus, past papers and free university-quality courses to learn from."
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {
              programs.map((program) => (
                <a
                  href={`/notes/${program.key}`}
                  class="group flex flex-col p-6 bg-white rounded-3xl border border-zinc-900 shadow-card hover:bg-lime-500 transition-colors"
                >
                  <span class="text-3xl font-bold">{program.name}</span>
                  <span class="mt-1 text-gray-700">{program.fullName}</span>
                  {program.note && (
                    <span class="mt-3 w-fit bg-zinc-100 text-xs font-medium px-2.5 py-0.5 rounded">
                      {program.note}
                    </span>
                  )}
                  <span class="mt-6 text-sm text-gray-500 group-hover:text-black">
                    8 semesters · {program.courses} courses
                  </span>
                </a>
              ))
            }
          </div>

          <section class="mt-12 p-6 md:p-10 bg-zinc-100 rounded-[45px]">
            <h2 class="text-2xl font-bold mb-4">What you'll find</h2>
            <ul class="grid gap-4 md:grid-cols-3">
              <li>
                <p class="font-bold">Official syllabus</p>
                <p class="text-gray-700">
                  The course of study published by Tribhuvan University.
                </p>
              </li>
              <li>
                <p class="font-bold">Past papers</p>
                <p class="text-gray-700">
                  Previous TU exam questions for each subject, many with
                  solutions.
                </p>
              </li>
              <li>
                <p class="font-bold">Free courses</p>
                <p class="text-gray-700">
                  Open courses and books from MIT, Harvard, Google and others
                  that cover the same topics.
                </p>
              </li>
            </ul>
            <p class="mt-6 text-sm text-gray-500">
              Past papers and notes are hosted by independent student sites.
              BOSC links to them but doesn't control their content. Have better
              notes? Use "Upload resources" to share them.
            </p>
          </section>
        </div>
      </div>
    </Container>
  </main>
</Layout>
