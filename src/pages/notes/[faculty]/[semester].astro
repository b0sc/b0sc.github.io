---
import Container from "../../../components/Container.astro"
import NavbarNotes from "../../../components/NavbarNotes.astro"
import Layout from "../../../layouts/Layout.astro"
import {
  faculties,
  getFaculty,
  resourcesFor,
  type Course,
} from "../../../utils/notes"

export function getStaticPaths() {
  return faculties.flatMap((faculty) =>
    getFaculty(faculty.key).data.semesters.map((sem) => ({
      params: { faculty: faculty.key, semester: String(sem.semester) },
    }))
  )
}

const { faculty, data } = getFaculty(Astro.params.faculty)
const number = Number(Astro.params.semester)
const semester = data.semesters.find((s) => s.semester === number)!
const groups: { title: string; courses: Course[] }[] = [
  { title: "Courses", courses: semester.courses },
  {
    title: "Electives",
    courses: semester.electiveCourses ?? [],
  },
].filter((group) => group.courses.length > 0)
---

<Layout
  title={`BOSC - ${faculty.name} Semester ${number}`}
  description={`${faculty.name} semester ${number}: courses, credits, past papers and free learning resources.`}
>
  <main class="pt-7 pb-20">
    <Container>
      <div class="flex flex-col md:flex-row gap-6">
        <NavbarNotes />
        <div class="flex-1 min-w-0 space-y-10">
          <header class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-sm text-gray-500">
                <a href="/notes" class="hover:underline">Notes</a> /
                <a href={`/notes/${faculty.key}`} class="hover:underline"
                  >{faculty.name}</a
                >
              </p>
              <h1 class="text-4xl font-bold mt-1">
                <span class="px-1.5 bg-lime-500 rounded-md"
                  >Semester {number}</span
                >
              </h1>
              <p class="mt-2 text-gray-700">
                {faculty.fullName}
                {faculty.note && ` · ${faculty.note}`}
              </p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a
                href={data.curriculum.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2 bg-zinc-900 hover:bg-white text-white hover:text-black border border-zinc-900 rounded-2xl"
              >
                Official syllabus
              </a>
              {
                semester.semesterLinks?.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2 bg-white hover:bg-black text-black hover:text-white border border-zinc-900 rounded-2xl"
                  >
                    {link.name}
                  </a>
                ))
              }
            </div>
          </header>

          {
            groups.map((group) => (
              <section>
                <h2 class="text-2xl font-bold mb-4">{group.title}</h2>
                <ul class="grid gap-6 lg:grid-cols-2">
                  {group.courses.map((course) => {
                    const resources = resourcesFor(course.name)
                    return (
                      <li class="flex flex-col p-6 bg-white rounded-3xl border border-zinc-900 shadow-card">
                        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                          {course.code && (
                            <span class="font-mono bg-zinc-100 text-black px-2 py-0.5 rounded">
                              {course.code}
                            </span>
                          )}
                          <span>
                            {course.credits === 1
                              ? "1 credit"
                              : `${course.credits} credits`}
                          </span>
                        </div>
                        <h3 class="mt-2 text-xl font-bold">{course.name}</h3>

                        {(course.pastQuestionsLink || course.notesLink) && (
                          <div class="flex flex-wrap gap-2 mt-4">
                            {course.notesLink && (
                              <a
                                href={course.notesLink}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-lime-500 hover:bg-black hover:text-white text-sm font-medium px-3 py-1 rounded-full"
                              >
                                BOSC notes
                              </a>
                            )}
                            {course.pastQuestionsLink && (
                              <a
                                href={course.pastQuestionsLink}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-lime-500 hover:bg-black hover:text-white text-sm font-medium px-3 py-1 rounded-full"
                              >
                                Past papers &amp; syllabus
                              </a>
                            )}
                          </div>
                        )}

                        {resources.length > 0 && (
                          <div class="mt-4 pt-4 border-t border-gray-200">
                            <p class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-2">
                              Free courses &amp; books
                            </p>
                            <ul class="space-y-1">
                              {resources.map((resource) => (
                                <li class="text-sm">
                                  <a
                                    href={resource.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="font-medium underline decoration-lime-500 decoration-2 underline-offset-4 hover:text-lime-700"
                                  >
                                    {resource.title}
                                  </a>
                                  <span class="text-gray-500">
                                    {" "}
                                    · {resource.provider}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </li>
                    )
                  })}
                </ul>
              </section>
            ))
          }

          <nav
            aria-label="Semesters"
            class="flex justify-between gap-4 pt-6 border-t border-gray-200"
          >
            {
              number > 1 ? (
                <a
                  href={`/notes/${faculty.key}/${number - 1}`}
                  class="font-medium hover:underline"
                >
                  ← Semester {number - 1}
                </a>
              ) : (
                <span />
              )
            }
            {
              number < data.semesters.length && (
                <a
                  href={`/notes/${faculty.key}/${number + 1}`}
                  class="font-medium hover:underline"
                >
                  Semester {number + 1} →
                </a>
              )
            }
          </nav>
        </div>
      </div>
    </Container>
  </main>
</Layout>
